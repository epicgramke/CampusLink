// PAGE ROUTER
async function render() {
  const id = ++renderId;
  if (!supabaseClient) return;

  const { data, error } = await supabaseClient.auth.getSession();
  if (id !== renderId) return;

  if (error) return fatal('Unable to read your login session. Refresh the page.');

  currentSession = data.session;
  const page = route();

  if (!currentSession) {
    if (!['login', 'register'].includes(page)) {
      go('login');
      renderAuth('login');
    } else {
      renderAuth(page);
    }
    return;
  }

  if (['login', 'register', ''].includes(page)) {
    if (location.hash !== '#home') location.hash = '#home';
    app.innerHTML = renderHome();
    setupNavigation();
    setupSearch();
    return;
  }

  if (page === 'home') {
    app.innerHTML = renderHome();
    setupNavigation();
    setupSearch();
  } else if (page === 'profile') {
    app.innerHTML = renderProfile(currentSession.user);
    setupNavigation();
  } else if (category(page)) {
    app.innerHTML = renderCategory(page);
    setupNavigation();
  } else {
    go('home');
  }
}

// START WEBSITE
async function start() {
  if (!app) throw new Error('Missing <div id="app"> in index.html.');

  if (!window.supabase?.createClient) {
    return fatal('Supabase did not load. Check your internet connection.');
  }

  supabaseClient = window.supabase.createClient(
    SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
  );

  supabaseClient.auth.onAuthStateChange((event, session) => {
    currentSession = session;
    if (event === 'SIGNED_OUT') {
      go('login');
      renderAuth('login');
    } else if (event === 'SIGNED_IN') {
      render();
    }
  });

  window.addEventListener('hashchange', render);

  if (!location.hash) location.hash = '#login';
  await render();
}

start().catch(error => {
  console.error('Campus Connect error:', error);
  fatal('Website could not start. Check your HTML and Supabase configuration.');
});

