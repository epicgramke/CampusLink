function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;',
    '"': '&quot;', "'": '&#39;'
  })[c]);
}

function route() {
  return (location.hash || '#login').replace(/^#\/?/, '').toLowerCase() || 'login';
}

function go(page) {
  location.hash = page;
}

function category(id) {
  return CATEGORIES.find(c => c.id === id);
}

function notice(message, type = 'success') {
  const box = document.getElementById('app-notice');
  if (!box) {
    alert(message);
    return;
  }
  box.textContent = message;
  box.className = `notice show ${type}`;
}

function fatal(message) {
  app.innerHTML = `
    <main class="auth-layout">
      <section class="auth-card">
        <h1>Campus Connect</h1>
        <p>${esc(message)}</p>
        <button class="primary" onclick="location.reload()">Reload website</button>
      </section>
    </main>`;
}

// LOGIN AND SIGNUP
function renderAuth(mode = 'login') {
  const registering = mode === 'register';

  app.innerHTML = `
    <main class="auth-layout">
      <section class="auth-card">
        <p class="eyebrow">CAMPUS CONNECT KENYA</p>
        <h1>${registering ? 'Create account' : 'Welcome back'}</h1>
        <p class="muted">${registering ? 'Join your student community.' : 'Sign in to continue.'}</p>
        <div id="app-notice" class="notice" role="status"></div>

        <form id="auth-form">
          ${registering ? `
            <div class="field">
              <label for="full-name">Full name</label>
              <input id="full-name" name="fullName" maxlength="80" required autocomplete="name" placeholder="Your full name">
            </div>` : ''}

          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com">
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" minlength="6" required autocomplete="${registering ? 'new-password' : 'current-password'}" placeholder="At least 6 characters">
          </div>

          ${registering ? `
            <div class="field">
              <label for="confirm-password">Confirm password</label>
              <input id="confirm-password" name="confirmPassword" type="password" minlength="6" required autocomplete="new-password" placeholder="Enter password again">
            </div>` : ''}

          <button class="primary" id="auth-submit" type="submit">
            ${registering ? 'Create account' : 'Sign in'}
          </button>
        </form>

        <p class="auth-switch">
          ${registering ? 'Already have an account?' : 'New to Campus Connect?'}
          <button class="text-button" id="auth-switch" type="button">
            ${registering ? 'Sign in' : 'Create account'}
          </button>
        </p>
      </section>
    </main>`;

  document.getElementById('auth-switch').onclick = () =>
    go(registering ? 'login' : 'register');

  document.getElementById('auth-form').addEventListener('submit', async e => {
    e.preventDefault();

    const form = e.currentTarget;
    const email = form.elements.email.value.trim();
    const password = form.elements.password.value;
    const button = document.getElementById('auth-submit');

    if (registering) {
      const name = form.elements.fullName.value.trim();

      if (!name) return notice('Enter your full name.', 'error');
      if (password !== form.elements.confirmPassword.value) {
        return notice('Passwords do not match.', 'error');
      }
      if (password.length < 6) {
        return notice('Password must have at least 6 characters.', 'error');
      }

      button.disabled = true;
      button.textContent = 'Creating account…';

      try {
        const { data, error } = await supabaseClient.auth.signUp({
          email,
          password,
          options: {
            data: { full_name: name },
            emailRedirectTo: `${location.origin}${location.pathname}#login`
          }
        });

        if (error) throw error;

        if (data.session) {
          currentSession = data.session;
          go('home');
          await render();
        } else {
          renderAuth('login');
          notice('Account created. Check your email for the confirmation link, then sign in.');
        }
      } catch (error) {
        notice(error.message || 'Signup failed.', 'error');
        button.disabled = false;
        button.textContent = 'Create account';
      }
    } else {
      button.disabled = true;
      button.textContent = 'Signing in…';

      try {
        const { data, error } = await supabaseClient.auth.signInWithPassword({
          email, password
        });

        if (error) throw error;

        currentSession = data.session;
        go('home');
        await render();
      } catch (error) {
        notice(error.message || 'Sign-in failed.', 'error');
        button.disabled = false;
        button.textContent = 'Sign in';
      }
    }
  });
}

// NAVIGATION
function header(active) {
  return `
    <header class="topbar">
      <div class="navwrap">
        <a class="brand" href="#home">CAMPUS <span>CONNECT</span></a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false">☰ Menu</button>
        <nav class="navlinks" id="main-navigation" hidden>
          <a href="#home" class="${active === 'home' ? 'active' : ''}">Home</a>
          ${CATEGORIES.map(c => `
            <a href="#${c.id}" class="${active === c.id ? 'active' : ''}">${c.icon} ${c.title}</a>
          `).join('')}
          <a href="#profile" class="${active === 'profile' ? 'active' : ''}">My profile</a>
          <button class="logout" id="logout-button" type="button">Sign out</button>
        </nav>
      </div>
    </header>`;
}

function setupNavigation() {
  const menu = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-navigation');

  if (menu && nav) {
    menu.onclick = () => {
      nav.hidden = !nav.hidden;
      menu.setAttribute('aria-expanded', String(!nav.hidden));
      menu.textContent = nav.hidden ? '☰ Menu' : '✕ Close';
    };
  }

  const logout = document.getElementById('logout-button');
  if (logout) {
    logout.onclick = async () => {
      logout.disabled = true;
      const { error } = await supabaseClient.auth.signOut();

      if (error) {
        logout.disabled = false;
        alert(error.message);
      } else {
        currentSession = null;
        go('login');
        await render();
      }
    };
  }
}

